      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
          "expr": "sum(otelcol_exporter_sent_spans{cluster=~\"$cluster\", exporter=\"otlp/tempo\"})",
          "legendFormat": "Spans no Tempo"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
