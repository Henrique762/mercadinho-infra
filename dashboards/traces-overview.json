      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
          "expr": "sum(rate(otelcol_receiver_accepted_spans{cluster=~\"$cluster\"}[1m]))",
          "legendFormat": "Spans/seg"
        }
      ]
    },
