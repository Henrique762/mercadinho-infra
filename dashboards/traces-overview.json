      "title": "Total de Spans Recebidos",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
          "expr": "sum(otelcol_receiver_accepted_spans{cluster=~\"$cluster\"})",
          "legendFormat": "Spans Recebidos"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "P4169E866C3094E38" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
