pipeline {
    // Retiramos o agente global. Cada estágio definirá seu próprio Pod isolado.
    agent none 
    
    environment {
        // Apontamento direto para o serviço interno do Harbor (ignora Envoy/HTTPS)
        HARBOR_REGISTRY = "harbor-core.harbor.svc.cluster.local/frontend"
        IMAGE_NAME = "mercadinho-frontend"
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        FULL_IMAGE = "${HARBOR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"
        // Imagem para ser salva no manifesto (via external URL)
        PUBLIC_IMAGE = "harbor.henrique.local/frontend/${IMAGE_NAME}:${IMAGE_TAG}"
    }

    stages {
        stage('Build & Push Image (Kaniko)') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: kaniko
    image: gcr.io/kaniko-project/executor:debug
    command:
    - sleep
    args:
    - 9999999
'''
                }
            }
            steps {
                // Traz o código para o workspace deste agente
                checkout scm
                
                withCredentials([usernamePassword(credentialsId: 'harbor-creds', passwordVariable: 'HARBOR_PASSWORD', usernameVariable: 'HARBOR_USERNAME')]) {
                    container('kaniko') {
                        echo "🔨 Construindo e enviando a imagem do Frontend para o Harbor via Kaniko (Rede Interna)..."
                        
                        sh '''
                          mkdir -p /kaniko/.docker
                          echo "{\\"auths\\":{\\"harbor-core.harbor.svc.cluster.local\\":{\\"auth\\":\\"`echo -n ${HARBOR_USERNAME}:${HARBOR_PASSWORD} | base64 | tr -d '\\n'`\\"}}}" > /kaniko/.docker/config.json
                          
                          /kaniko/executor \
                            --context `pwd`/frontend \
                            --dockerfile `pwd`/frontend/Dockerfile \
                            --destination ${FULL_IMAGE} \
                            --insecure \
                            --insecure-pull \
                            --skip-tls-verify
                        '''
                    }
                }
            }
        }

        stage('Security Scan (Trivy)') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: trivy
    image: aquasec/trivy:latest
    command:
    - cat
    tty: true
'''
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'harbor-creds', passwordVariable: 'TRIVY_PASSWORD', usernameVariable: 'TRIVY_USERNAME')]) {
                    container('trivy') {
                        echo "🛡️ Executando análise de vulnerabilidades na rede interna..."
                        sh """
                          trivy image --insecure --severity HIGH,CRITICAL --exit-code 1 --no-progress ${FULL_IMAGE}
                        """
                    }
                }
            }
        }

        stage('Update Manifest & Push') {
            agent {
                kubernetes {
                    yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: git
    image: alpine/git:2.40.1
    command:
    - sleep
    args:
    - 9999999
'''
                }
            }
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-credentials', passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                    container('git') {
                        echo "📝 Atualizando a versão da imagem no manifesto do frontend e enviando para o repositório Git..."
                        
                        sh """
                          git config --global --add safe.directory '*'
                          git config --global user.email "jenkins@henrique.local"
                          git config --global user.name "Jenkins CI"
                          
                          # Modificar a linha da imagem usando a PUBLIC_IMAGE (harbor.henrique.local)
                          sed -i "s|image: .*|image: ${PUBLIC_IMAGE}|g" manifests/frontend/frontend_deploy.yaml
                          
                          # Verificar se houve mudanças
                          git status
                          
                          # Adicionar, Commitar e Enviar (Push)
                          git add manifests/frontend/frontend_deploy.yaml
                          git commit -m "ci/cd: Atualiza a imagem do Frontend para a tag ${IMAGE_TAG} [skip ci]" || echo "Nenhuma alteração para commitar"
                          
                          # Configurar URL com credenciais (usando x-access-token para evitar erro com e-mails no username)
                          git remote set-url origin https://x-access-token:${GIT_PASSWORD}@github.com/Henrique762/mercadinho.git
                          git push origin HEAD:main
                        """
                    }
                }
            }
        }
    }
}